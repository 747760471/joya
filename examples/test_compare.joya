public class Main {
    public static void main() {
        // Float comparisons
        float a = 3.14;
        float b = 2.71;
        println(a > b);        // true
        println(a < b);        // false
        println(a >= 3.14);    // true
        println(a <= 3.14);    // true
        println(a == 3.14);    // true
        println(a != 2.71);    // true

        // Int/float mixed comparisons
        int x = 3;
        float y = 3.5;
        println(x < y);        // true
        println(y > x);        // true
        println(x == 3);       // true

        // String comparisons (lexicographic)
        string s1 = "abc";
        string s2 = "abd";
        println(s1 < s2);      // true
        println(s2 > s1);      // true
        println(s1 == "abc");  // true
        println(s1 != s2);     // true
    }
}
