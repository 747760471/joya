class Math {
    static int max(int a, int b) {
        if (a > b) {
            return a;
        }
        return b;
    }

    static int min(int a, int b) {
        if (a < b) {
            return a;
        }
        return b;
    }

    static int abs(int x) {
        if (x < 0) {
            return -x;
        }
        return x;
    }
}
