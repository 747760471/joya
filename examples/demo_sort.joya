// Joya Comprehensive Demo: Concurrent Sum + Bubble Sort
// Tests: arrays, methods, return values, goroutines, channels, for-each, nested loops

public class Main {
    public static void main() {
        int[] data = [64, 34, 25, 12, 22, 11, 90, 45, 78, 33];

        // Print original array
        println("=== Original Array ===");
        printArray(data);

        // Parallel partial sum using goroutines + channels
        chan<int> ch = new chan<int>(2);
        go {
            int s = partialSum(data, 0, 5);
            send(ch, s);
        };
        go {
            int s = partialSum(data, 5, 10);
            send(ch, s);
        };
        int sum1 = receive(ch);
        int sum2 = receive(ch);
        println("Parallel sum: " + (sum1 + sum2));

        // Sequential sum for verification
        println("Sequential sum: " + sumArray(data));

        // Find max
        println("Max: " + findMax(data));

        // Bubble sort
        bubbleSort(data);
        println("=== Sorted Array ===");
        printArray(data);
    }

    static int partialSum(int[] arr, int start, int end) {
        int sum = 0;
        for (int i = start; i < end; i++) {
            sum = sum + arr[i];
        }
        return sum;
    }

    static int sumArray(int[] arr) {
        int total = 0;
        for (int x : arr) {
            total = total + x;
        }
        return total;
    }

    static int findMax(int[] arr) {
        int max = arr[0];
        for (int i = 1; i < arr.length; i++) {
            if (arr[i] > max) {
                max = arr[i];
            }
        }
        return max;
    }

    static void bubbleSort(int[] arr) {
        int n = arr.length;
        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                if (arr[j] > arr[j + 1]) {
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }
    }

    static void printArray(int[] arr) {
        for (int x : arr) {
            print(x + " ");
        }
        println("");
    }
}
