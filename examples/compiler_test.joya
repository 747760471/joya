class Hello {
    static int main() {
        int x = 10;
        int y = 20;
        int z = x + y;
        println(z);
        
        if (z > 25) {
            println(100);
        } else {
            println(0);
        }
        
        int sum = 0;
        int i = 0;
        while (i < 5) {
            sum = sum + i;
            i = i + 1;
        }
        println(sum);
        
        return 0;
    }
}
